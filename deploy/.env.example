# 首次管理员密码至少 12 字符、UTF-8 最多 72 字节；主密钥为 32 字节随机数的 Base64，已有数据须保留原值。
FLINK_WEB_ADMIN_PASSWORD=
FLINK_WEB_MASTER_KEY=
FLINK_WEB_NAMESPACE=flink-jobs
FLINK_WEB_S3_BUCKET=
FLINK_WEB_S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FLINK_WEB_AI_TELEMETRY_ENABLED=false
FLINK_WEB_AI_TELEMETRY_MODE=collector
FLINK_WEB_AI_TELEMETRY_CAPTURE_CONTENT=true
LANGFUSE_TRACING_ENVIRONMENT=default
LANGFUSE_BASE_URL=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
