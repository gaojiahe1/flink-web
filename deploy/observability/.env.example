# Supply project keys locally; never commit .env.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_OTLP_BASE_URL=http://host.docker.internal:3000/api/public/otel
LANGFUSE_BASE_URL=http://127.0.0.1:3000
# Backend process environment (set separately, not a Collector credential):
# FLINK_WEB_AI_TELEMETRY_ENABLED=true
# FLINK_WEB_AI_TELEMETRY_MODE=direct
# Or choose collector mode and the OTLP endpoint below.
# FLINK_WEB_OTEL_TRACES_ENDPOINT=http://127.0.0.1:14318/v1/traces
